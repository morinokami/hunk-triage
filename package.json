{
  "name": "hunk-triage",
  "version": "0.3.0",
  "private": true,
  "description": "Read the important changes first: Jev-powered review ordering for hunk.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run fmt:check && bun run typecheck && bun test --isolate",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "@opentui/core": "0.6.0",
    "@opentui/react": "0.6.0",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "hunkdiff": "0.23.0",
    "oxfmt": "0.68.0",
    "react": "19.3.0",
    "typescript": "7.0.2"
  },
  "hunk": {
    "extensions": [
      "./src/index.tsx"
    ],
    "apiVersion": 25
  }
}
